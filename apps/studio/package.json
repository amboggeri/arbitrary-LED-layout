{
  "name": "@ledlay/studio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "The ledlay GUI: 3D layout editor, effect/timeline programming, live preview and output.",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.json --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@ledlay/core": "workspace:*",
    "@ledlay/editor": "workspace:*",
    "@ledlay/effects": "workspace:*",
    "@ledlay/engine": "workspace:*",
    "@ledlay/io": "workspace:*",
    "@ledlay/link": "workspace:*",
    "@ledlay/targets": "workspace:*",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "three": "^0.186.1",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/dom": "^10.4.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^6.1.2",
    "jsdom": "^30.1.3",
    "vite": "^8.3.4"
  }
}
